# Supabase — Project Settings → API. Without these the site still runs:
# the blog shows MDX posts only, /link shows the built-in links, /admin shows a setup screen.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The only account allowed into /admin. Must match public.is_admin() in supabase/migrations/0001_init.sql.
ADMIN_EMAIL=siaexplains@gmail.com
